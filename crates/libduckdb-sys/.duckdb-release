# Pinned Haybarn engine build for libhaybarn-sys. Single source of truth for
# which engine the crates target. Used by the build script, upgrade.sh and CI.
#
# Linked-mode builds (no `bundled` feature, no DUCKDB_LIB_DIR) download
#   <DUCKDB_RELEASE_URL>/libhaybarn-<platform>.zip
# and link against the shared library inside. Opt out with
# DUCKDB_DOWNLOAD_LIB=0, or force the download with DUCKDB_DOWNLOAD_LIB=1.
#
# DUCKDB_RELEASE_COMMIT  Full hash of the Haybarn engine commit the libraries
#                        were built from. `./upgrade.sh --sync` vendors exactly
#                        this commit into the bundled sources and regenerates
#                        the pregenerated bindings, so `bundled` builds and the
#                        download never disagree.
# DUCKDB_RELEASE_URL     Directory holding the per-platform archives: a Haybarn
#                        GitHub release,
#                        https://github.com/Query-farm-haybarn/haybarn/releases/download/<tag>.
#                        Never point this at DuckDB's own binaries; they carry
#                        DuckDB's extension trust root, not Haybarn's.
# DUCKDB_RELEASE_VERSION The Haybarn release tag of the build. Names the
#                        download cache directory, so it must change whenever
#                        the URL does.
#
# Edit by hand on an engine bump (upstream's `Create Release Version PR`
# workflow is not used by Haybarn), then run `./upgrade.sh --sync` to update
# the `bundled` files.

DUCKDB_RELEASE_COMMIT=5ab8a76db12ad1ad63c4e4997bce37602a9d0b43
DUCKDB_RELEASE_URL=https://github.com/Query-farm-haybarn/haybarn/releases/download/haybarn-v2.0.0-rc6
DUCKDB_RELEASE_VERSION=haybarn-v2.0.0-rc6